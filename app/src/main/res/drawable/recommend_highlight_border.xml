<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/memo_highlight_shadow"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <!-- Highlighted border and content -->
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <stroke android:width="1dp" android:color="@color/memo_highlight_border"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
