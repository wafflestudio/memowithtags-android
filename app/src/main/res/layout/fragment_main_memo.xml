<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_screen">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@color/bg_screen"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Memo with Tags"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iconSearch"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/search_icon"
            android:contentDescription="Search"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/iconSettings"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_marginStart="14dp"
            android:src="@drawable/hamburger_button"
            android:contentDescription="Settings"
            app:tint="@color/text_primary"/>
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="0.4dp"
        android:background="@color/border_divider"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/memoRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintBottom_toTopOf="@id/newMemoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/bg_screen"/>

    <LinearLayout
        android:id="@+id/recommendStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/newMemoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:gravity="end|center_vertical">

        <TextView
            android:id="@+id/recommendText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- / -"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="4dp" />

        <FrameLayout
            android:id="@+id/recommendButtonGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp">

            <View
                android:id="@+id/recommendBackground"
                android:layout_width="70dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_recommend_middle"
                android:elevation="0dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrevRecommend"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_arrow_up"
                    android:background="@drawable/bg_recommend_button"
                    app:tint="@color/text_primary"
                    android:contentDescription="이전 추천" />

                <ImageButton
                    android:id="@+id/btnNextRecommend"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_arrow_down"
                    android:background="@drawable/bg_recommend_button"
                    app:tint="@color/text_primary"
                    android:layout_marginStart="6dp"
                    android:contentDescription="다음 추천" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/newMemoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="9dp"
        android:layout_margin="4dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/tagInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@android:color/transparent"
        app:cardBackgroundColor="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="9dp"
            android:paddingTop="10dp"
            android:paddingBottom="7dp"
            android:background="@drawable/rounded_noborder">

        <LinearLayout
                android:id="@+id/newMemoBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:gravity="center_vertical"
                android:background="@android:color/transparent">

                <EditText
                    android:id="@+id/newMemoText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="새로운 메모"
                    android:lineSpacingMultiplier="1.3"
                    android:background="@drawable/rounded_noborder"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/newMemoIcon"
                    android:layout_width="24dp"
                    android:layout_height="25dp"
                    android:src="@drawable/newmemo_icon"
                    app:tint="@color/text_primary"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/selectedTagRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="6dp"/>

            <LinearLayout
                android:id="@+id/newMemoIconBar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent">

                <ImageView
                    android:id="@+id/zoomButton"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/zoom_icon" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/newMemoButton"
                    android:layout_width="24dp"
                    android:layout_height="25dp"
                    android:src="@drawable/newmemo_icon"
                    app:tint="@color/text_primary"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/tagInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:padding="8dp"
        android:background="@color/bg_screen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 새 태그 입력 영역 -->
        <EditText
            android:id="@+id/tagInputEditText"
            android:layout_width="71dp"
            android:layout_height="wrap_content"
            android:saveEnabled="false"
            android:hint="태그 찾기"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2.5dp"
            android:background="@drawable/rounded_noborder"
            android:backgroundTint="@color/bg_tag_input"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="none"
            android:scrollHorizontally="true"
            android:gravity="center_vertical"/>

        <View
            android:layout_width="0.3dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@color/border_tag_input" />

        <!-- 신규 태그 만들기 -->
        <TextView
            android:id="@+id/inputTagButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/tag_background"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/makeTagText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="만들기"
            android:textSize="14sp"
            android:visibility="gone"
            android:gravity="center_vertical" />

        <!-- 기존 태그 RecyclerView (가로 스크롤) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tagRecyclerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:overScrollMode="never"
            android:scrollbars="horizontal"
            tools:listitem="@layout/item_tag" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
